#include <windows.h>
#include "resource_ids.h"

1 24 "@GC_APP_MANIFEST_RC@"
IDI_APP_ICON ICON "@GC_APP_ICON_RC@"

// Co-author identity input box. The geometry here is only a placeholder: the real positions and
// the window size are laid out in pixels inside WM_INITDIALOG, so the dialog scales exactly like
// the rest of the UI. All texts (caption, labels, buttons) are left empty on purpose and are set
// from C++ as UTF-16, which keeps this script free of non-ASCII bytes.
IDD_COMMIT_IDENTITY_DIALOG DIALOGEX 0, 0, 250, 78
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_IDENTITY_LABEL, 7, 7, 236, 8
    EDITTEXT        IDC_IDENTITY_EDIT, 7, 18, 236, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_IDENTITY_NOTE, 7, 34, 236, 16
    DEFPUSHBUTTON   "", IDOK, 183, 58, 60, 14
    PUSHBUTTON      "", IDCANCEL, 117, 58, 60, 14
END

// Remote picker for "fetch": one explanation line, a single-selection list of the
// existing remotes (name plus fetch URL), and OK/Cancel. Like the identity box above,
// every text is set from C++ as UTF-16 and the geometry is only a placeholder that
// WM_INITDIALOG re-arranges in per-monitor DPI pixels.
IDD_FETCH_REMOTE_DIALOG DIALOGEX 0, 0, 260, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_REMOTE_LABEL, 7, 7, 246, 8
    LISTBOX         IDC_REMOTE_LIST, 7, 19, 246, 70, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 193, 93, 60, 14
    PUSHBUTTON      "", IDCANCEL, 126, 93, 60, 14
END
