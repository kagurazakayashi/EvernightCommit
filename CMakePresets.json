{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64（多配置，无需开发者命令提示符）",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64（多配置，无需开发者命令提示符）",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "ninja-x64",
      "displayName": "Ninja Multi-Config x64（需在“Developer Command Prompt for VS”中运行）",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "description": "需要 cl.exe 与 rc.exe 已在 PATH 中（例如先运行 vcvars64.bat）；x64 由该环境决定。"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-x64",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-x64",
      "configuration": "Release",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
